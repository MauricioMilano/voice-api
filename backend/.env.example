# Copy to .env and adjust as needed
APP_NAME=VoiceAPI Gateway
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where the database file (and any other local data) lives.
# In Docker: /app/data is a volume mount.
# Local dev:  ./data is created automatically next to this .env file.
DATA_DIR=/app/data

# SQLite URL — absolute path so it works no matter which dir uvicorn launches from.
# For a Postgres backend, use: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:////app/data/voice_api.db

# Sidecar (whisper-small service from voice-chat repo)
SIDECAR_BASE_URL=http://127.0.0.1:8001
SIDECAR_TIMEOUT_SECONDS=120

# CORS — comma-separated origins, or "*" for dev
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Default STT model exposed to clients (informational)
STT_MODEL=whisper-small

# Idle-eviction (sidecar): release Whisper model from RAM after N seconds of disuse.
# 0 disables. Default 300. Cold-start penalty ~2-5s on next request after idle.
WHISPER_IDLE_EVICTION_SECONDS=300

# ----------------------------------------------------------------------
# Logging — see README "Troubleshooting" for how to read these
# ----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
# Optional: also write to this file (rotated at 20MB x 5)
# LOG_FILE=/app/logs/gateway.log