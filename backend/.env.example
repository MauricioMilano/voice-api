# Copy to .env and adjust as needed
APP_NAME=VoiceAPI Gateway
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default; switch to postgres/mysql in prod)
DATABASE_URL=sqlite:///./data/voice_api.db

# Sidecar (whisper turbo large v3 service from voice-chat repo)
SIDECAR_BASE_URL=http://127.0.0.1:8001
SIDECAR_TIMEOUT_SECONDS=120

# CORS — comma-separated origins, or "*" for dev
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Default STT model exposed to clients (informational)
STT_MODEL=whisper-large-v3-turbo

# ----------------------------------------------------------------------
# Logging — see README "Troubleshooting" for how to read these
# ----------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log format: text (human) | json (machine-friendly)
LOG_FORMAT=text
# Optional: also write to this file (rotated at 20MB x 5)
# Leave commented to log only to stdout (recommended for docker)
# LOG_FILE=/app/logs/gateway.log